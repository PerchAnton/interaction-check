{
  "schema": 1,
  "name": "01-save-edit-restore",
  "steps": [
    {
      "event": {
        "op": "new"
      },
      "expect": {
        "elements": [
          {
            "id": "a",
            "x": 10,
            "y": 20
          }
        ]
      }
    },
    {
      "event": {
        "op": "save"
      },
      "expect": {
        "elements": [
          {
            "x": 10
          }
        ]
      }
    },
    {
      "event": {
        "op": "move",
        "x": 50,
        "y": 60
      },
      "expect": {
        "elements": [
          {
            "x": 50,
            "y": 60
          }
        ]
      }
    },
    {
      "event": {
        "op": "restore"
      },
      "expect": {
        "elements": [
          {
            "id": "a",
            "x": 10,
            "y": 20,
            "width": 30,
            "height": 40
          }
        ]
      }
    }
  ]
}
