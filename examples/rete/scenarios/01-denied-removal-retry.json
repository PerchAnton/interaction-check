{
  "schema": 1,
  "name": "01-denied-removal-retry",
  "steps": [
    {
      "event": {
        "op": "new"
      },
      "expect": {
        "nodes": []
      }
    },
    {
      "event": {
        "op": "add_node",
        "id": "a"
      },
      "expect": {
        "nodes": [
          "a"
        ],
        "result": true
      }
    },
    {
      "event": {
        "op": "block",
        "signal": "noderemove"
      },
      "expect": {
        "nodes": [
          "a"
        ]
      }
    },
    {
      "event": {
        "op": "remove_node",
        "id": "a"
      },
      "expect": {
        "nodes": [
          "a"
        ],
        "result": false
      }
    },
    {
      "event": {
        "op": "block",
        "signal": null
      },
      "expect": {
        "nodes": [
          "a"
        ]
      }
    },
    {
      "event": {
        "op": "remove_node",
        "id": "a"
      },
      "expect": {
        "nodes": [],
        "result": true
      }
    }
  ]
}
