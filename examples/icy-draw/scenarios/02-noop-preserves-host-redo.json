{
  "schema": 1,
  "name": "02-noop-preserves-host-redo",
  "steps": [
    {
      "event": {
        "op": "new"
      },
      "expect": {
        "name": "original",
        "undo": 0
      }
    },
    {
      "event": {
        "op": "direct",
        "name": "other"
      },
      "expect": {
        "name": "other",
        "undo": 1
      }
    },
    {
      "event": {
        "op": "undo"
      },
      "expect": {
        "name": "original",
        "undo": 0,
        "can_redo": true
      }
    },
    {
      "event": {
        "op": "open"
      },
      "expect": {
        "open": true
      }
    },
    {
      "event": {
        "op": "confirm"
      },
      "expect": {
        "name": "original",
        "undo": 0,
        "can_redo": true,
        "last": "noop"
      }
    },
    {
      "event": {
        "op": "redo"
      },
      "expect": {
        "name": "other",
        "undo": 1
      }
    }
  ]
}
