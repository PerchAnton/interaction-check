{
  "schema": 1,
  "name": "automerge / 02-save-load",
  "steps": [
    {
      "event": {
        "op": "new",
        "text": "🙂"
      },
      "expect": {
        "a": "🙂"
      }
    },
    {
      "event": {
        "op": "insert",
        "peer": "a",
        "index": 2,
        "text": "界"
      },
      "expect": {
        "a": "🙂界"
      }
    },
    {
      "event": {
        "op": "roundtrip",
        "peer": "a"
      },
      "expect": {
        "a": "🙂界"
      }
    },
    {
      "event": {
        "op": "merge",
        "from": "a",
        "to": "b"
      },
      "expect": {
        "b": "🙂界",
        "same_heads": true
      }
    }
  ]
}
