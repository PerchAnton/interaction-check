{
  "schema": 1,
  "name": "tanstack-store / conditional-derived",
  "steps": [
    {
      "event": {
        "op": "new",
        "left": "L",
        "right": "R"
      },
      "expect": {
        "selected": "L",
        "seen": []
      }
    },
    {
      "event": {
        "op": "set",
        "side": "right",
        "value": "R2"
      },
      "expect": {
        "selected": "L",
        "seen": []
      }
    },
    {
      "event": {
        "op": "select",
        "side": "right"
      },
      "expect": {
        "selected": "R2",
        "seen": [
          "R2"
        ]
      }
    },
    {
      "event": {
        "op": "set",
        "side": "left",
        "value": "L2"
      },
      "expect": {
        "selected": "R2",
        "seen": [
          "R2"
        ]
      }
    },
    {
      "event": {
        "op": "set",
        "side": "right",
        "value": "R3"
      },
      "expect": {
        "selected": "R3",
        "seen": [
          "R2",
          "R3"
        ]
      }
    }
  ]
}
