{
  "schema": 1,
  "name": "blinker / sender-routing",
  "steps": [
    {
      "event": {
        "op": "connect",
        "sender": "left"
      },
      "expect": {
        "log": []
      }
    },
    {
      "event": {
        "op": "send",
        "sender": "right",
        "value": 1,
        "muted": false
      },
      "expect": {
        "log": [],
        "delivered": 0
      }
    },
    {
      "event": {
        "op": "send",
        "sender": "left",
        "value": 2,
        "muted": false
      },
      "expect": {
        "log": [
          {
            "sender": "left",
            "value": 2
          }
        ],
        "delivered": 1
      }
    },
    {
      "event": {
        "op": "connect",
        "sender": "right"
      },
      "expect": {
        "log": [
          {
            "sender": "left",
            "value": 2
          }
        ]
      }
    },
    {
      "event": {
        "op": "send",
        "sender": "right",
        "value": 3,
        "muted": false
      },
      "expect": {
        "log": [
          {
            "sender": "left",
            "value": 2
          },
          {
            "sender": "right",
            "value": 3
          }
        ],
        "delivered": 1
      }
    }
  ]
}
