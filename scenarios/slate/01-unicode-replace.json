{
  "schema": 1,
  "name": "slate / 01-unicode-replace",
  "steps": [
    {
      "event": {
        "op": "new",
        "text": "A🙂界"
      },
      "expect": {
        "text": "A🙂界",
        "undo": 0
      }
    },
    {
      "event": {
        "op": "select",
        "from": 1,
        "to": 3
      },
      "expect": {
        "text": "A🙂界"
      }
    },
    {
      "event": {
        "op": "insert",
        "text": "é"
      },
      "expect": {
        "text": "Aé界",
        "undo": 1
      }
    },
    {
      "event": {
        "op": "undo"
      },
      "expect": {
        "text": "A🙂界",
        "redo": 1
      }
    },
    {
      "event": {
        "op": "redo"
      },
      "expect": {
        "text": "Aé界",
        "redo": 0
      }
    }
  ]
}
