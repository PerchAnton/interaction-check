{
  "schema": 1,
  "name": "jsonpatch / escaped-pointer-and-list-insert",
  "steps": [
    {
      "event": {
        "op": "new",
        "data": {
          "a/b": 1,
          "items": [
            1
          ]
        }
      },
      "expect": {
        "document": {
          "a/b": 1,
          "items": [
            1
          ]
        }
      }
    },
    {
      "event": {
        "op": "apply",
        "patch": [
          {
            "op": "replace",
            "path": "/a~1b",
            "value": 2
          },
          {
            "op": "add",
            "path": "/items/-",
            "value": 3
          },
          {
            "op": "add",
            "path": "/m~0n",
            "value": 4
          }
        ],
        "in_place": false
      },
      "expect": {
        "document": {
          "a/b": 2,
          "items": [
            1,
            3
          ],
          "m~n": 4
        },
        "error": null
      }
    },
    {
      "event": {
        "op": "apply",
        "patch": [
          {
            "op": "remove",
            "path": "/items/0"
          }
        ],
        "in_place": false
      },
      "expect": {
        "document": {
          "a/b": 2,
          "items": [
            3
          ],
          "m~n": 4
        },
        "error": null
      }
    }
  ]
}
