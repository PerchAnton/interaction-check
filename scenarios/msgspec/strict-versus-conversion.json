{
  "schema": 1,
  "name": "msgspec / strict-versus-conversion",
  "steps": [
    {
      "event": {
        "op": "validate",
        "data": {
          "name": "A",
          "count": "3"
        },
        "strict": true
      },
      "expect": {
        "valid": false,
        "output": null,
        "paths": [],
        "input_unchanged": true,
        "keys": []
      }
    },
    {
      "event": {
        "op": "validate",
        "data": {
          "name": "A",
          "count": "3"
        },
        "strict": false
      },
      "expect": {
        "valid": true,
        "output": {
          "name": "A",
          "count": 3,
          "enabled": true
        },
        "paths": [],
        "input_unchanged": true,
        "keys": [
          "count",
          "enabled",
          "name"
        ]
      }
    },
    {
      "event": {
        "op": "validate",
        "data": {
          "name": "A",
          "count": 4
        },
        "strict": true
      },
      "expect": {
        "valid": true,
        "output": {
          "name": "A",
          "count": 4,
          "enabled": true
        },
        "paths": [],
        "input_unchanged": true,
        "keys": [
          "count",
          "enabled",
          "name"
        ]
      }
    }
  ]
}
