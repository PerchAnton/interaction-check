{
  "schema": 1,
  "name": "redux / noop-still-notifies",
  "steps": [
    {
      "event": {
        "op": "new"
      },
      "expect": {
        "value": {
          "count": 0,
          "title": ""
        },
        "seen": [],
        "order": []
      }
    },
    {
      "event": {
