{
  "schema": 1,
  "name": "traitlets / held-notifications-coalesce",
  "steps": [
    {
      "event": {
        "op": "write",
        "hold": true,
        "updates": [
          {
            "field": "count",
            "value": 1
          },
          {
            "field": "count",
            "value": 2
          }
        ]
      },
      "expect": {
        "count": 2,
        "log": [
          {
            "field": "count",
            "old": 0,
            "new": 2
          }
        ]
      }
    },
    {
      "event": {
        "op": "write",
        "hold": false,
        "updates": [
          {
            "field": "count",
            "value": 2
          }
        ]
      },
      "expect": {
        "count": 2,
        "log": [
          {
            "field": "count",
            "old": 0,
            "new": 2
          }
        ]
      }
    },
    {
      "event": {
        "op": "write",
        "hold": false,
        "updates": [
          {
            "field": "count",
            "value": 3
          }
        ]
      },
      "expect": {
        "count": 3,
        "log": [
          {
            "field": "count",
            "old": 0,
            "new": 2
          },
          {
            "field": "count",
            "old": 2,
            "new": 3
          }
        ]
      }
    }
  ]
}
