{
  "schema": 1,
  "name": "yjs / 01-concurrent-merge",
  "steps": [
    {
      "event": {
        "op": "new",
        "text": "base"
      },
      "expect": {
        "a": "base",
        "b": "base"
      }
    },
    {
      "event": {
        "op": "insert",
        "peer": "a",
        "index": 0,
        "text": "!"
      },
      "expect": {
        "a": "!base"
      }
    },
    {
      "event": {
        "op": "insert",
        "peer": "b",
        "index": 4,
        "text": "?"
      },
      "expect": {
        "b": "base?"
      }
    },
    {
      "event": {
        "op": "sync",
        "from": "a",
        "to": "b"
      },
      "expect": {
        "b": "!base?"
      }
    },
    {
      "event": {
        "op": "sync",
        "from": "b",
        "to": "a"
      },
      "expect": {
        "a": "!base?",
        "b": "!base?"
      }
    },
    {
      "event": {
        "op": "sync",
        "from": "b",
        "to": "a"
      },
      "expect": {
        "a": "!base?",
        "b": "!base?"
      }
    }
  ]
}
