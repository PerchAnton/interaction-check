{
  "schema": 1,
  "name": "PhotoCraft: 08-duplicate-commit",
  "steps": [
    {
      "event": {
        "op": "begin"
      },
      "expect": {
        "error": null,
        "command_count": 0
      }
    },
    {
      "event": {
        "op": "begin"
      },
      "expect": {
        "error": "already editing",
        "command_count": 0
      }
    },
    {
      "event": {
        "op": "preview",
        "value": 0.5
      },
      "expect": {
        "error": null,
        "command_count": 0
      }
    },
    {
      "event": {
        "op": "commit"
      },
      "expect": {
        "committed": 0.5,
        "undo_depth": 1,
        "error": null,
        "command_count": 1
      }
    },
    {
      "event": {
        "op": "commit"
      },
      "expect": {
        "committed": 0.5,
        "undo_depth": 1,
        "error": "no draft",
        "command_count": 1
      }
    }
  ]
}
