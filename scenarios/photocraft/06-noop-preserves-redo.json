{
  "schema": 1,
  "name": "PhotoCraft: 06-noop-preserves-redo",
  "steps": [
    {
      "event": {
        "op": "external",
        "value": 0.5
      },
      "expect": {
        "committed": 0.5,
        "undo_depth": 1,
        "error": null,
        "command_count": 1
      }
    },
    {
      "event": {
        "op": "undo"
      },
      "expect": {
        "committed": 1,
        "can_redo": true,
        "error": null,
        "command_count": 1
      }
    },
    {
      "event": {
        "op": "begin"
      },
      "expect": {
        "error": null,
        "command_count": 1
      }
    },
    {
      "event": {
        "op": "preview",
        "value": 0.5
      },
      "expect": {
        "preview": 0.5,
        "error": null,
        "command_count": 1
      }
    },
    {
      "event": {
        "op": "preview",
        "value": 1
      },
      "expect": {
        "preview": 1,
        "error": null,
        "command_count": 1
      }
    },
    {
      "event": {
        "op": "commit"
      },
      "expect": {
        "committed": 1,
        "undo_depth": 0,
        "can_redo": true,
        "error": null,
        "command_count": 1
      }
    },
    {
      "event": {
        "op": "redo"
      },
      "expect": {
        "committed": 0.5,
        "undo_depth": 1,
        "error": null,
        "command_count": 1
      }
    }
  ]
}
